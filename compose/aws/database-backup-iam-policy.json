{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDatabaseBackupBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::midtnvbc-postgres-backups-db"
    },
    {
      "Sid": "ManageDatabaseBackupObjects",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:GetObject",
        "s3:GetObjectTagging",
        "s3:ListMultipartUploadParts",
        "s3:PutObject",
        "s3:PutObjectTagging"
      ],
      "Resource": "arn:aws:s3:::midtnvbc-postgres-backups-db/postgres/*"
    }
  ]
}
