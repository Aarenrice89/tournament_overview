# Compose
COMPOSE_PROJECT_NAME=tournament_overview

# Django
DJANGO_SETTINGS_MODULE=tournament_overview.settings
DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-development-secret
SUPER_USER_PASSWORD=replace-with-a-development-admin-password
ALLOWED_HOSTS=api.tournament-overview.localhost,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://api.tournament-overview.localhost
CORS_ALLOWED_ORIGINS=
COOKIE_DOMAIN=
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SITE_URL=https://api.tournament-overview.localhost

# PostgreSQL
POSTGRES_DB=tournament_overview
POSTGRES_NAME=tournament_overview
POSTGRES_USER=tournament_overview
POSTGRES_PASSWORD=replace-with-a-development-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_DB=1
REDIS_MEMOIZE_DB=2

# Resend email delivery
RESEND_API_KEY=
# Must use a sender address from a verified Resend domain.
DEFAULT_FROM_EMAIL=Mid TN VBC <coaches@midtnvbc.com>
