# Django
DJANGO_SETTINGS_MODULE=tournament_overview.settings
DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-new-long-random-secret
ALLOWED_HOSTS=midtnvbc.ricehouse.me
CSRF_TRUSTED_ORIGINS=https://midtnvbc.ricehouse.me
CORS_ALLOWED_ORIGINS=
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000

# PostgreSQL
POSTGRES_DB=tournament_overview
POSTGRES_NAME=tournament_overview
POSTGRES_USER=tournament_overview
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_DB=1

# Optional email delivery
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SITE_URL=https://midtnvbc.ricehouse.me
